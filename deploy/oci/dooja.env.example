# Copy to /etc/dooja/dooja.env on the server. chmod 600. Never commit the filled file.
# Names only. Leave secrets empty here and set them on the server.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5080
Database__Provider=Sqlite
ConnectionStrings__Dooja=Data Source=/var/lib/dooja/dooja.db
Seed__Demo=false
Features__Reels=false
AllowedHosts=
Cors__Origins__0=
Jwt__Key=
Admin__Password=

# Leave SMS unset. Phone verification stays paused on purpose.
# Do not set Sms__Provider, Sms__AccountSid, Sms__AuthToken, or Sms__From.
