@model DashboardVm
@{ViewData["Title"]="نظرة عامة"; var max=Math.Max(1,Model.Week.Max(x=>x.Count));}
<section class="page-heading"><div><div class="eyebrow">أهلاً بيك بلوحة ضوجة ✦</div><h1>كل شي بمكان واحد</h1><p>تابع حجوزاتك، أماكنك، وكل التفاصيل اللي تهمك.</p></div><a class="btn primary" asp-controller="Places" asp-action="Create">＋ إضافة مكان</a></section>
<section class="welcome-banner"><div><span class="pill light">نخلّي الطلعة أحلى</span><h2>وين نطلع اليوم؟</h2><p>تجارب جديدة، أماكن مميزة، وحجوزات بدون تعقيد.</p><a asp-controller="Bookings" asp-action="Index">شوف كل الحجوزات ←</a></div><div class="banner-art" aria-hidden="true"><span>✦</span><div><img src="/logo/mark_white.svg" alt=""/></div><span>✧</span></div></section>
<section class="kpi-grid"><article class="kpi"><div><span>حجوزات اليوم</span><i>▦</i></div><strong>@Model.TodayBookings.ToString("N0")</strong><small>عدا الحجوزات الملغية</small></article><article class="kpi"><div><span>إيراد اليوم</span><i class="green">↗</i></div><strong>@Model.TodayIncome.ToString("N0") <em>د.ع</em></strong><small>وصول مسجل أو حجز مكتمل</small></article><article class="kpi"><div><span>الأماكن المسجّلة</span><i class="amber">⌖</i></div><strong>@Model.Places</strong><small>كل الأماكن على المنصة</small></article><article class="kpi"><div><span>المستخدمون</span><i>♧</i></div><strong>@Model.Users</strong><small>زبائن، أصحاب أماكن، وإدارة</small></article></section>
<section class="split-grid"><article class="panel"><div class="section-head"><h2>نشاط الحجوزات</h2><span class="muted">آخر 7 أيام · بتوقيت بغداد</span></div><div class="chart" aria-label="حجوزات آخر سبعة أيام">@foreach(var d in Model.Week){<div class="chart-col"><strong>@d.Count</strong><div class="bar-track"><div style="height:@(Math.Max(3,(int)(d.Count*100.0/max)))%"></div></div><small dir="ltr">@d.Label</small></div>}</div></article><article class="panel attention"><span class="attention-icon">◷</span><h2>طلبات تنتظر موافقتك</h2><strong>@Model.Pending</strong><p>راجع الطلبات الجديدة حتى تتأكد طلعاتهم.</p><a class="btn soft" href="/Bookings?status=@Uri.EscapeDataString("بانتظار القبول")">مراجعة الطلبات ←</a></article></section>
<section class="panel"><div class="section-head"><div><h2>آخر الحجوزات</h2><p class="muted">آخر الطلبات المسجلة على المنصة</p></div><a asp-controller="Bookings" asp-action="Index">عرض الكل ←</a></div><partial name="_BookingTable" model="Model.Recent"/></section>
<section class="panel"><div class="section-head"><h2>الأماكن الأكثر متابعة</h2><a asp-controller="Places" asp-action="Index">كل الأماكن ←</a></div><div class="place-mini-grid">@foreach(var p in Model.Popular){<a href="/Places/Edit/@p.Id" class="place-mini"><div class="place-visual @p.ImageKey"><span>⌖</span><small>@p.Category</small></div><h3>@p.Name</h3><p>@p.Area · @p.Followers.ToString("N0") متابع</p></a>}</div></section>
