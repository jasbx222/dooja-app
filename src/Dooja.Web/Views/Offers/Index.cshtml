@model List<Offer>
@{ViewData["Title"]="العروض";}
<div class="page-heading"><div><div class="eyebrow">عرض أحلى، طلعة أكثر</div><h1>العروض</h1><p>أضف عروضك وتابع تفاعل الزبائن.</p></div><a class="btn primary" asp-action="Create">＋ عرض جديد</a></div><div class="offers-grid">@foreach(var o in Model){<article class="panel offer-card"><div class="section-head"><span class="offer-icon">◇</span><span class="status @(o.Active?"ok":"pending")">@(o.Active?"فعّال":"متوقف")</span></div><small class="muted">@o.Place?.Name · @o.Area</small><h2>@o.Title</h2><p>@o.Disc</p><div class="offer-price"><strong>@o.NewPrice.ToString("N0") <small>د.ع</small></strong><del>@o.OldPrice.ToString("N0")</del></div><p class="muted">◷ @o.ExpiryText @o.ExpiresOn?.ToString("yyyy-MM-dd")</p><div class="offer-stats"><div><strong>@o.Views.ToString("N0")</strong><small>مشاهدة</small></div><div><strong>@o.Clicks.ToString("N0")</strong><small>نقرة</small></div><div><strong>@o.Books</strong><small>حجز</small></div></div><div class="card-foot"><a asp-action="Edit" asp-route-id="@o.Id">تعديل العرض ←</a><form asp-action="Toggle" method="post"><input name="id" type="hidden" value="@o.Id"/><button class="text-btn">@(o.Active?"إيقاف":"تفعيل")</button></form></div></article>}</div>@if(Model.Count==0){<div class="panel empty">بعد ماكو عروض</div>}
