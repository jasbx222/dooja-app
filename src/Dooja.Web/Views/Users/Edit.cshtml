@model AppUser
@{ViewData["Title"]="تفاصيل المستخدم";}
<div class="page-heading"><div><h1>تفاصيل المستخدم</h1><p>إدارة الحساب والدور والنقاط.</p></div><a asp-action="Index" class="btn ghost">رجوع</a></div><form asp-action="Save" method="post" class="panel edit-form"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><div><label asp-for="Name">الاسم</label><input asp-for="Name"/></div><div><label asp-for="Phone">رقم الهاتف</label><input asp-for="Phone" dir="ltr" placeholder="07700000001"/></div><div><label asp-for="Role">الدور</label><select asp-for="Role"><option value="Customer">زبون</option><option value="Owner">صاحب مكان</option></select></div><div><label asp-for="Governorate">المحافظة</label><input asp-for="Governorate"/></div><div><label asp-for="Area">المنطقة</label><input asp-for="Area"/></div><div><label asp-for="Birth">تاريخ الميلاد</label><input asp-for="Birth"/></div><div><label asp-for="Points">النقاط</label><input asp-for="Points" min="0"/></div><div class="check-group"><label><input asp-for="Active"/> الحساب فعّال</label></div></div><div class="form-actions"><button class="btn primary">حفظ المستخدم</button><a asp-action="Index" class="btn ghost">إلغاء</a></div></form>
