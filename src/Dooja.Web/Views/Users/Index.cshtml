@model List<AppUser>
@{ViewData["Title"]="المستخدمون";}
<div class="page-heading"><div><div class="eyebrow">ناس ضوجة</div><h1>المستخدمون</h1><p>حسابات الزبائن وأصحاب الأماكن.</p></div><a class="btn primary" asp-action="Create">＋ إضافة مستخدم</a></div><form class="toolbar" method="get"><input name="q" value="@ViewBag.Q" placeholder="ابحث بالاسم أو رقم الهاتف"/><button class="btn soft">بحث</button></form><section class="panel table-wrap"><table><thead><tr><th>المستخدم</th><th>رقم الهاتف</th><th>الدور</th><th>المنطقة</th><th>النقاط</th><th>الحالة</th><th></th></tr></thead><tbody>@foreach(var u in Model){<tr><td><div class="user-cell"><div class="avatar">@(u.Name.Length>0?u.Name[..1]:"ض")</div><strong>@u.Name</strong></div></td><td dir="ltr">@u.Phone</td><td>@(u.Role=="Owner"?"صاحب مكان":u.Role=="Admin"?"مدير":"زبون")</td><td>@u.Governorate · @u.Area</td><td>@u.Points.ToString("N0")</td><td><span class="status @(u.Active?"ok":"bad")">@(u.Active?"فعّال":"موقوف")</span></td><td>@if(u.Role!="Admin"){<a asp-action="Edit" asp-route-id="@u.Id">تعديل ←</a>}</td></tr>}@if(Model.Count==0){<tr><td class="empty" colspan="7">ماكو نتائج</td></tr>}</tbody></table></section>
