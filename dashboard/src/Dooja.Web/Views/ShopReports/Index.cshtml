@{
    ViewData["Title"] = "مبيعات المتجر";
    var days = ((IEnumerable<ShopDayRow>)ViewBag.Days).ToList();
    var best = (IEnumerable<ShopSoldRow>)ViewBag.Best;
    var least = (IEnumerable<ShopSoldRow>)ViewBag.Least;
    var max = (long)ViewBag.Peak;
    var revenue = (long)ViewBag.Revenue;
    var orders = (int)ViewBag.Orders;
    var cancelled = (int)ViewBag.Cancelled;
    var live = orders - cancelled;
    var avg = live > 0 ? revenue / live : 0;
    var from = (string)ViewBag.From;
    var to = (string)ViewBag.To;
    var today = Dooja.Web.Services.BookingService.Today;
    string D(DateOnly d) => d.ToString("yyyy-MM-dd");
    var ranges = new[]
    {
        ("آخر 7 أيام", D(today.AddDays(-6)), D(today)),
        ("آخر 30 يوم", D(today.AddDays(-29)), D(today)),
        ("هذا الشهر", D(new DateOnly(today.Year, today.Month, 1)), D(today)),
    };
    var chartEmpty = days.All(x => x.Total == 0);
}
<div class="page-bar">
    <p class="lead">الأرقام محسوبة من الطلبات غير الملغاة داخل الفترة، بتوقيت بغداد.</p>
</div>

<div class="range-bar">
    <nav class="chips" aria-label="فترات جاهزة">
        @foreach (var (label, f, t) in ranges)
        {
            <a class="@(f == from && t == to ? "on" : null)" href="?from=@f&to=@t">@label</a>
        }
    </nav>
    <form method="get" class="range-form">
        <label>من<input type="date" name="from" value="@from"/></label>
        <label>إلى<input type="date" name="to" value="@to"/></label>
        <button class="btn ghost compact">عرض</button>
    </form>
</div>

<section class="stat-board" aria-label="ملخص المبيعات">
    <article class="stat"><div class="stat-label ok">@Ui.Icon("wallet") <span>المبيعات</span></div><strong class="num">@revenue.ToString("N0") <em>د.ع</em></strong><small>من @live.ToString("N0") طلب غير ملغي</small></article>
    <a class="stat" asp-controller="ShopOrders" asp-action="Index" asp-route-from="@from" asp-route-to="@to"><div class="stat-label">@Ui.Icon("layout-grid") <span>الطلبات</span></div><strong class="num">@orders.ToString("N0")</strong><small>@(((int)ViewBag.Pending).ToString("N0")) بانتظار التأكيد</small></a>
    <article class="stat"><div class="stat-label info">@Ui.Icon("chart-column") <span>متوسط الطلب</span></div><strong class="num">@avg.ToString("N0") <em>د.ع</em></strong><small>المبيعات ÷ الطلبات</small></article>
    <article class="stat"><div class="stat-label ok">@Ui.Icon("circle-check") <span>تم التوصيل</span></div><strong class="num">@(((int)ViewBag.Completed).ToString("N0"))</strong><small>طلب مكتمل</small></article>
    <article class="stat"><div class="stat-label bad">@Ui.Icon("circle-x") <span>ملغي</span></div><strong class="num">@cancelled.ToString("N0")</strong><small>@(orders > 0 ? $"{cancelled * 100 / orders}% من الطلبات" : "لا طلبات")</small></article>
</section>

<section class="panel block">
    <div class="section-head"><div><h2>المبيعات اليومية</h2><p>بالدينار العراقي، بدون الملغى</p></div></div>
    @if (chartEmpty)
    {
        <p class="empty-note">لا مبيعات في هذه الفترة.</p>
    }
    else
    {
        <div class="bars" aria-label="المبيعات اليومية">
            @foreach (var d in days)
            {
                <div class="bar-col" title="@d.Label: @d.Total.ToString("N0") د.ع">
                    <strong>@(d.Total == 0 ? "" : d.Total >= 1000 ? $"{d.Total / 1000:N0}k" : d.Total.ToString("N0"))</strong>
                    <div class="bar-plot"><span class="money" style="height:@(d.Total == 0 ? 2 : Math.Max(4, d.Total * 100 / max))%"></span></div>
                    <small class="date">@d.Label</small>
                </div>
            }
        </div>
    }
</section>

<div class="duo">
    <section class="panel">
        <div class="section-head"><div><h2>الأكثر مبيعاً</h2><p>حسب عدد القطع</p></div></div>
        @if (!best.Any()) { <p class="empty-note">لا مبيعات في هذه الفترة.</p> }
        else
        {
            <ol class="rank">
                @{ var i = 0; }
                @foreach (var r in best)
                {
                    <li><div class="rank-row"><span class="rank-no">@(++i)</span>@Ui.Thumb(r.Image, r.Name, "thumb sm")<strong>@r.Name</strong><span class="rank-meta">@r.Qty قطعة<small class="muted">@r.Total.ToString("N0") د.ع</small></span></div></li>
                }
            </ol>
        }
    </section>
    <section class="panel">
        <div class="section-head"><div><h2>الأقل مبيعاً</h2><p>منتجات بيعت قليلاً في الفترة</p></div></div>
        @if (!least.Any()) { <p class="empty-note">لا مبيعات في هذه الفترة.</p> }
        else
        {
            <ol class="rank">
                @{ var j = 0; }
                @foreach (var r in least)
                {
                    <li><div class="rank-row"><span class="rank-no">@(++j)</span>@Ui.Thumb(r.Image, r.Name, "thumb sm")<strong>@r.Name</strong><span class="rank-meta">@r.Qty قطعة<small class="muted">@r.Total.ToString("N0") د.ع</small></span></div></li>
                }
            </ol>
        }
    </section>
</div>
