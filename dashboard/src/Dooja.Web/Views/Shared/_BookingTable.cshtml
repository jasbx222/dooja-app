@model IEnumerable<Booking>
<div class="table-wrap"><table><thead><tr><th>رمز الحجز</th><th>المكان / الزبون</th><th>الموعد</th><th>المبلغ</th><th>الحالة</th></tr></thead><tbody>@foreach(var b in Model){<tr><td><strong dir="ltr">@b.Code</strong></td><td><strong>@b.Place?.Name</strong><small>@b.User?.Name</small></td><td>@b.Day.ToString("yyyy-MM-dd")<small>@b.Time · @b.Duration</small></td><td>@b.Total.ToString("N0") د.ع<small>@b.PayMethod</small></td><td><span class="status @(b.Status=="مؤكد"||b.Status=="مكتمل"?"ok":b.Status=="ملغي"?"bad":"pending")">@b.Status</span></td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="empty">بعد ماكو حجوزات</td></tr>}</tbody></table></div>
