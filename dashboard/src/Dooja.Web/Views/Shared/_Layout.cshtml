@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var login = current == "Auth";
    var title = ViewData["Title"]?.ToString() ?? "ضوجة";
    var name = User.Identity?.Name;
    if (string.IsNullOrWhiteSpace(name)) name = "مدير ضوجة";
    var search = ViewData["Search"] as string;
    var query = ViewData["Q"] as string ?? "";
    var statusFilter = ViewData["Status"] as string;
    var groups = new (string Label, bool Open, (string Controller, string Icon, string Text)[] Items)[]
    {
        ("التشغيل", current is "Home" or "Bookings", [("Home", "house", "نظرة عامة"), ("Bookings", "calendar-check", "الحجوزات")]),
        ("المحتوى", current is "Places" or "Offers" or "Reviews", [("Places", "store", "الأماكن"), ("Offers", "badge-percent", "العروض"), ("Reviews", "star", "التقييمات")]),
        ("الحسابات", current == "Users", [("Users", "users", "المستخدمون")])
    };
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="theme-color" content="#7C3AED"/>
    <link rel="icon" href="/logo/mark_purple.svg" type="image/svg+xml"/>
    <title>@title · ضوجة</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/dooja.css" asp-append-version="true"/>
</head>
<body class="@(login ? "login-body" : "")">
<div class="nav-progress" aria-hidden="true"></div>
@if (!login)
{
    <input class="nav-toggle" id="nav-toggle" type="checkbox"/>
    <label class="scrim" for="nav-toggle" aria-label="إغلاق القائمة"></label>
    <aside class="sidebar" id="sidebar">
        <a class="brand" href="/">
            <img src="/logo/mark_purple.svg" alt=""/>
            <span>ضوجة<small>DOOJA</small></span>
        </a>
        <nav aria-label="القائمة الرئيسية">
            @foreach (var group in groups)
            {
                <details class="nav-group" open='@(group.Open ? "open" : null)'>
                    <summary>@group.Label @Ui.Icon("chevron-down")</summary>
                    @foreach (var item in group.Items)
                    {
                        <a href="/@item.Controller" class='@(current == item.Controller ? "active" : null)' aria-current='@(current == item.Controller ? "page" : null)'>
                            @Ui.Icon(item.Icon)<span>@item.Text</span>
                        </a>
                    }
                </details>
            }
        </nav>
        <p class="sidebar-foot">نغيّر جوّك</p>
    </aside>
    <div class="workspace">
        <header class="topbar">
            <label class="icon-btn menu-btn" for="nav-toggle" aria-controls="sidebar">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                <span class="sr">القائمة</span>
            </label>
            <div class="top-title">
                <nav class="crumbs" aria-label="مسار الصفحة">ضوجة <span aria-hidden="true">/</span> @title</nav>
                <h1>@title</h1>
            </div>
            @if (search != null)
            {
                <form class="top-search" method="get" action="@Url.Action("Index")">
                    @if (!string.IsNullOrEmpty(statusFilter))
                    {
                        <input type="hidden" name="status" value="@statusFilter"/>
                    }
                    @Ui.Icon("search")
                    <input type="search" name="q" value="@query" placeholder="@search" aria-label="@search" autocomplete="off"/>
                </form>
            }
            <div class="top-tools">
                @await Component.InvokeAsync("OpsAlerts")
                <details class="menu">
                    <summary class="profile-btn" aria-label="حساب المدير">
                        <span class="avatar">@Ui.Initial(name)</span>
                        <span class="profile-name">@name</span>
                        @Ui.Icon("chevron-down")
                    </summary>
                    <div class="menu-panel">
                        <p class="profile-meta"><strong>@name</strong><small>مدير المنصة</small></p>
                        <form asp-controller="Auth" asp-action="Logout" method="post" data-confirm="تسجيل الخروج من لوحة ضوجة؟" data-confirm-ok="خروج">
                            <button class="btn ghost wide" type="submit">@Ui.Icon("log-out") تسجيل الخروج</button>
                        </form>
                    </div>
                </details>
            </div>
        </header>
        <main>
            @if (TempData["Success"] is string success)
            {
                <div class="alert success" role="status">@Ui.Icon("circle-check") <span>@success</span></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert error" role="alert">@Ui.Icon("circle-x") <span>@error</span></div>
            }
            @RenderBody()
        </main>
    </div>
}
else
{
    @RenderBody()
}
<dialog id="confirm" class="dialog" aria-labelledby="confirm-title">
    <form method="dialog">
        <h2 id="confirm-title">تأكيد</h2>
        <p id="confirm-text"></p>
        <div class="dialog-actions">
            <button class="btn ghost" type="submit" value="cancel">إلغاء</button>
            <button class="btn primary" type="submit" value="ok" id="confirm-ok">تأكيد</button>
        </div>
    </form>
</dialog>
<script src="~/js/dooja.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
