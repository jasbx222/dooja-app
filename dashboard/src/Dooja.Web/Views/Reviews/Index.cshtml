@model List<Review>
@{ViewData["Title"]="التقييمات";}
<div class="page-heading"><div><div class="eyebrow">نسمع رأيهم</div><h1>التقييمات</h1><p>راجع تجارب الزبائن ورد على تقييماتهم.</p></div><span class="pill">@Model.Count تقييم</span></div><div class="reviews-grid">@foreach(var r in Model){<article class="panel review-card"><div class="section-head"><div class="user-cell"><div class="avatar">@(r.Name.Length>0?r.Name[..1]:"ض")</div><div><h3>@r.Name</h3><small class="muted">@r.Place?.Name · @r.Ago</small></div></div><span class="rating">@(new string('★',r.Stars))</span></div><p class="review-text">@r.Text</p>@if(r.HasPhotos){<small class="muted">التقييم الأصلي يذكر صوراً — الملفات غير مستوردة</small>}@if(!string.IsNullOrWhiteSpace(r.Reply)){<blockquote><strong>رد المكان</strong><p>@r.Reply</p></blockquote>}<form asp-action="Reply" method="post"><input type="hidden" name="id" value="@r.Id"/><label for="reply-@r.Id">@(r.Reply==null?"ردّك على التقييم":"تعديل الرد")</label><textarea id="reply-@r.Id" name="text" maxlength="2000" required rows="2" placeholder="اكتب ردّك هنا...">@r.Reply</textarea><button class="btn soft compact">حفظ الرد ←</button></form></article>}</div>@if(Model.Count==0){<div class="panel empty">بعد ماكو تقييمات</div>}
