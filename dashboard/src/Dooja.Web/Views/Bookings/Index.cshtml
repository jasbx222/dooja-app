@model PagedList<Booking>
@{
    ViewData["Title"] = "الحجوزات";
    ViewData["Search"] = "رمز الحجز، اسم الزبون أو المكان";
    var status = ViewData["Status"] as string;
    var q = ViewData["Q"] as string;
}
<div class="page-bar">
    <p class="lead">@Model.Page.Total.ToString("N0") حجز ضمن النتائج. تغيير الحالة يبقى حسب مسار الحجز الحالي.</p>
</div>
<nav class="chips" aria-label="تصفية الحالة">
    <a class="@(string.IsNullOrEmpty(status) ? "on" : null)" href="@Ui.FilterHref(Url.Action("Index"), q, null)">الكل</a>
    @foreach (var s in BookingStates.All)
    {
        <a class="@(status == s ? "on" : null)" href="@Ui.FilterHref(Url.Action("Index"), q, s)">@s</a>
    }
</nav>
<section class="panel table-panel">
    <div class="table-wrap">
        <table class="stack">
            <thead><tr><th>الحجز</th><th>المكان / الزبون</th><th>التاريخ والوقت</th><th>التفاصيل</th><th>الحالة</th><th>الإجراء</th></tr></thead>
            <tbody>
            @foreach (var b in Model.Items)
            {
                <tr>
                    <td data-label="الحجز"><strong dir="ltr">@b.Code</strong><small>@b.PayMethod</small></td>
                    <td data-label="المكان / الزبون"><strong>@b.Place?.Name</strong><small>@b.User?.Name · <span dir="ltr">@b.User?.Phone</span></small></td>
                    <td data-label="التاريخ والوقت">@b.Day.ToString("yyyy-MM-dd")<small>@b.Time</small></td>
                    <td data-label="التفاصيل">@b.Total.ToString("N0") د.ع<small>@b.People أشخاص · @b.Duration</small></td>
                    <td data-label="الحالة"><span class="status @Ui.StatusClass(b.Status)">@b.Status</span>@if (b.Arrived) { <small>تم الوصول</small> }</td>
                    <td data-label="الإجراء">
                        <form asp-action="Status" method="post" class="inline-form" data-confirm="تغيير حالة الحجز @b.Code؟" data-confirm-ok="حفظ">
                            <input type="hidden" name="id" value="@b.Id"/>
                            <select name="status" aria-label="تغيير حالة الحجز @b.Code">
                                @foreach (var s in BookingStates.All.Where(s => BookingStates.CanChange(b.Status, s)))
                                {
                                    <option selected="@(s == b.Status)">@s</option>
                                }
                            </select>
                            <button class="btn soft compact" type="submit">حفظ</button>
                        </form>
                        @if (b.Status == "مؤكد" && !b.Arrived)
                        {
                            <form asp-action="Arrive" method="post" data-confirm="تسجيل وصول الحجز @b.Code؟" data-confirm-ok="تسجيل الوصول">
                                <input type="hidden" name="id" value="@b.Id"/>
                                <button class="btn ghost compact" type="submit">تسجيل الوصول</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6" class="empty">ماكو حجوزات مطابقة. غيّر البحث أو التصفية.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Page"/>
</section>
