@model List<Booking>
@{ViewData["Title"]="الحجوزات";}
<div class="page-heading"><div><div class="eyebrow">رتّب طلعاتهم</div><h1>الحجوزات</h1><p>طلبات الحجز وحالاتها، مباشرة من قاعدة البيانات.</p></div><span class="pill">@Model.Count حجز بالنتائج</span></div><form method="get" class="toolbar"><input name="q" value="@ViewBag.Q" placeholder="رمز الحجز، اسم الزبون أو المكان"/><select name="status"><option value="">كل الحالات</option>@foreach(var s in BookingStates.All){<option value="@s" selected="@(ViewBag.Status==s)">@s</option>}</select><button class="btn soft">تصفية</button></form>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>الحجز</th><th>المكان / الزبون</th><th>التاريخ والوقت</th><th>التفاصيل</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>@foreach(var b in Model){<tr><td><strong dir="ltr">@b.Code</strong><small>@b.PayMethod</small></td><td><strong>@b.Place?.Name</strong><small>@b.User?.Name · @b.User?.Phone</small></td><td>@b.Day.ToString("yyyy-MM-dd")<small>@b.Time</small></td><td>@b.Total.ToString("N0") د.ع<small>@b.People أشخاص · @b.Duration</small></td><td><span class="status @(b.Status=="مؤكد"||b.Status=="مكتمل"?"ok":b.Status=="ملغي"?"bad":"pending")">@b.Status</span>@if(b.Arrived){<small>✓ تم الوصول</small>}</td><td><form asp-action="Status" method="post" class="inline-form"><input type="hidden" name="id" value="@b.Id"/><select name="status" aria-label="تغيير حالة الحجز">@foreach(var s in BookingStates.All.Where(s=>BookingStates.CanChange(b.Status,s))){<option selected="@(s==b.Status)">@s</option>}</select><button class="btn soft compact">حفظ</button></form>@if(b.Status=="مؤكد"&&!b.Arrived){<form asp-action="Arrive" method="post"><input type="hidden" name="id" value="@b.Id"/><button class="text-btn">تسجيل الوصول</button></form>}</td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="empty">ماكو حجوزات مطابقة</td></tr>}</tbody></table></div></section>
