@model List<Place>
@{ViewData["Title"]="الأماكن";}
<div class="page-heading"><div><div class="eyebrow">أماكن تغيّر الجو</div><h1>الأماكن</h1><p>@Model.Count مكان ضمن نتائج البحث</p></div><a asp-action="Create" class="btn primary">＋ إضافة مكان</a></div><form method="get" class="toolbar"><input name="q" value="@ViewBag.Q" placeholder="ابحث باسم المكان أو المنطقة..."/><button class="btn soft">بحث</button></form>
<div class="places-grid">@foreach(var p in Model){<article class="place-card"><div class="place-visual @p.ImageKey"><span>⌖</span><small>@p.Category</small>@if(p.Featured){<b>✦ مميز</b>}</div><div class="place-body"><div class="section-head"><h2>@p.Name</h2><span class="rating">★ @p.Rating</span></div><p>@p.Area · @p.Type</p><div class="place-info"><strong>@p.Price.ToString("N0") <small>د.ع / @p.Unit</small></strong><span class="status @(p.Active?"ok":"bad")">@(p.Active?"فعّال":"مخفي")</span></div><div class="card-foot"><small>المالك: @p.OwnerUser?.Name</small><a asp-action="Edit" asp-route-id="@p.Id">تعديل ←</a></div></div></article>}</div>@if(Model.Count==0){<div class="panel empty">ماكو أماكن مطابقة. أضف مكاناً أو غيّر البحث.</div>}
