@model LoginVm
@{ ViewData["Title"] = "تسجيل الدخول"; }
<main class="login-shell">
    <section class="login-story">
        <a class="brand" href="/">
            <img src="/logo/mark_white.svg" alt=""/>
            <span>ضوجة<small>DOOJA</small></span>
        </a>
        <div class="story-copy">
            <h1>كل طلعة حلوة تبدأ من هنا.</h1>
            <p>إدارة الأماكن والحجوزات والعروض من نفس بيانات التطبيق.</p>
        </div>
        <small>نغيّر جوّك</small>
    </section>
    <section class="login-form">
        <p class="kicker">لوحة الإدارة</p>
        <h2>سجّل دخولك</h2>
        <p class="lead">حساب الإدارة فقط.</p>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="validation"></div>
            <div class="field"><label asp-for="Phone">رقم الهاتف</label><input asp-for="Phone" dir="ltr" inputmode="tel" autocomplete="username" placeholder="07xxxxxxxxx"/></div>
            <div class="field"><label asp-for="Password">كلمة المرور</label><input asp-for="Password" dir="ltr" autocomplete="current-password"/></div>
            <button class="btn primary wide" type="submit">تسجيل الدخول</button>
        </form>
    </section>
</main>
