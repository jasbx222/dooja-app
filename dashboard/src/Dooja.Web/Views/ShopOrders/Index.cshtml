@model IEnumerable<ShopOrder>
@{
    ViewData["Title"] = "طلبات المتجر";
    ViewData["Search"] = "رقم الطلب أو الاسم أو الهاتف";
    ViewData["Q"] = ViewBag.Q as string;
}
<div class="page-bar">
    <p class="lead">@Model.Count().ToString("N0") طلب ضمن النتائج. الأوقات بتوقيت بغداد.</p>
</div>
<form method="get" class="toolbar">
    <input type="hidden" name="q" value="@ViewBag.Q"/>
    <select name="status" aria-label="الحالة"><option value="">كل الحالات</option>@foreach (var s in (string[])ViewBag.Statuses) { <option value="@s" selected="@(ViewBag.Status as string == s)">@s</option> }</select>
    <input type="date" name="from" value="@ViewBag.From" aria-label="من تاريخ"/>
    <input type="date" name="to" value="@ViewBag.To" aria-label="إلى تاريخ"/>
    <button class="btn ghost">تصفية</button>
</form>
<section class="panel table-panel">
    <div class="table-wrap">
        <table class="stack">
            <thead><tr><th>الطلب</th><th>الزبون</th><th>الإجمالي</th><th>الدفع</th><th>الحالة</th><th></th></tr></thead>
            <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td data-label="الطلب"><strong>@o.Number</strong><small>@Ui.Local(o.CreatedAt)</small></td>
                    <td data-label="الزبون">@o.CustomerName<small><bdi dir="ltr">@o.Phone</bdi></small></td>
                    <td data-label="الإجمالي"><strong class="price">@o.Total.ToString("N0")</strong><small>د.ع</small></td>
                    <td data-label="الدفع">@o.PayMethod</td>
                    <td data-label="الحالة"><span class="status @(o.Status == "ملغي" ? "bad" : o.Status == "تم التوصيل" ? "ok" : "pending")">@o.Status</span></td>
                    <td data-label="إجراء"><a class="btn ghost compact" asp-action="Detail" asp-route-id="@o.Id">التفاصيل</a></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td class="empty" colspan="6">ماكو طلبات ضمن هذا البحث.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
